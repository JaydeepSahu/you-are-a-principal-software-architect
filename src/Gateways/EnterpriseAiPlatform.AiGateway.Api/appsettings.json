{
  "AiGateway": {
    "Authentication": {
      "PlatformJwt": {
        "Issuer": "",
        "Audience": "",
        "SigningKey": ""
      }
    },
    "RateLimiting": {
      "RedisConnectionString": "",
      "KeyPrefix": "eap:ai-gateway:rate-limit",
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Forwarding": {
      "BaseAddress": "",
      "TimeoutSeconds": 30,
      "ForwardedBy": "enterprise-ai-platform-ai-gateway"
    }
  },
  "Resilience": {
    "OpenRecoveryTimeoutSeconds": 15,
    "MinimumThresholdCount": 4,
    "FailureRateTripThresholdPercentage": 50.0,
    "ProviderFallbackChain": {
      "AzureOpenAi": "Anthropic",
      "Anthropic": "GoogleGemini",
      "GoogleGemini": "SelfHostedVllm",
      "SelfHostedVllm": "CopilotProxy",
      "CopilotProxy": "AzureOpenAi"
    }
  },
  "Dlp": {
    "EnableGlobalScanning": true,
    "CustomRules": [
      {
        "Name": "Internal Project Key",
        "Category": "SecretKey",
        "RegexPattern": "\\b(PROJ_KEY_[A-Z0-9]{12})\\b",
        "ReplacementToken": "[REDACTED_PROJ_KEY]",
        "Action": "Mask",
        "IsEnabled": true
      }
    ]
  },
  "Rag": {
    "ChunkSize": 500,
    "ChunkOverlap": 50,
    "RrfKConstant": 60.0,
    "DefaultTopK": 5
  },
  "FinOps": {
    "DefaultMonthlyTokenLimit": 1000000000,
    "DefaultMonthlyBudgetLimitDollars": 50000.00,
    "SoftWarningThresholdPercentage": 75.0,
    "HardQuotaBlockThresholdPercentage": 100.0
  },
  "AgentFramework": {
    "DefaultMaxRetries": 3,
    "InitialRetryDelayMs": 100,
    "ExecutionTimeoutSeconds": 300,
    "EnableSseStreaming": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
