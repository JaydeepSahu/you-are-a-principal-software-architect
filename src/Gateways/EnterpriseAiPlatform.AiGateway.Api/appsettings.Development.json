{
  "AiGateway": {
    "Authentication": {
      "PlatformJwt": {
        "Issuer": "https://identity.enterprise-ai-platform.test",
        "Audience": "enterprise-ai-platform",
        "SigningKey": "0123456789abcdef0123456789abcdef"
      }
    },
    "RateLimiting": {
      "RedisConnectionString": "localhost:6379,abortConnect=false",
      "KeyPrefix": "eap:ai-gateway:dev:rate-limit",
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Forwarding": {
      "BaseAddress": "http://localhost:5261/internal/ai/",
      "TimeoutSeconds": 30,
      "ForwardedBy": "enterprise-ai-platform-ai-gateway"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
