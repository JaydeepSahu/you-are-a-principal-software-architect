# =============================================================================
# Enterprise AI Platform — Docker Environment Configuration (.env.example)
# Copy this file to '.env' to override default configuration values.
# =============================================================================

# ASP.NET Core Environment (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Development

# Shared platform JWT for local Docker development.
# Replace in shared/non-development environments with a secret from your vault.
PLATFORM_JWT_ISSUER=https://identity.enterprise-ai-platform.test
PLATFORM_JWT_AUDIENCE=enterprise-ai-platform
PLATFORM_JWT_SIGNING_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# PostgreSQL Database Configuration
POSTGRES_DB=enterprise_ai_db
POSTGRES_USER=ai_platform_user
POSTGRES_PASSWORD=SecretPassword123!

# Grafana Admin Password
GRAFANA_ADMIN_PASSWORD=admin
