# =============================================================================
# Enterprise AI Platform — Docker Environment Configuration (.env.example)
# =============================================================================
# Copy this file to '.env' to override default configuration values.
# NEVER commit the actual .env file — it may contain secrets.
# =============================================================================

# --- ASP.NET Core -----------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# --- Platform JWT (shared for local Docker development) ----------------------
# Replace in shared/non-development environments with secrets from your vault.
PLATFORM_JWT_ISSUER=https://identity.enterprise-ai-platform.test
PLATFORM_JWT_AUDIENCE=enterprise-ai-platform
PLATFORM_JWT_SIGNING_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=enterprise_ai_db
POSTGRES_USER=ai_platform_user
POSTGRES_PASSWORD=ChangeMe

# --- Redis -------------------------------------------------------------------
# No credentials required for local development (default config).

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=ai_platform
RABBITMQ_PASSWORD=ChangeMe

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin

# --- CI/CD (optional — used for pre-built image pattern) ---------------------
# CONTAINER_REGISTRY=ghcr.io/your-org
# IMAGE_TAG=latest
