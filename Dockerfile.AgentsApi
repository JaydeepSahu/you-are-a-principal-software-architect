# Multi-stage production Dockerfile for Enterprise Agent Framework API
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy Directory props & configs
COPY ["Directory.Build.props", "."]
COPY ["Directory.Packages.props", "."]
COPY ["global.json", "."]

# Copy Projects
COPY ["src/BuildingBlocks/", "src/BuildingBlocks/"]
COPY ["src/Services/Agents/", "src/Services/Agents/"]

# Restore & Publish
RUN dotnet restore "src/Services/Agents/EnterpriseAiPlatform.Agents.Api/EnterpriseAiPlatform.Agents.Api.csproj"
RUN dotnet publish "src/Services/Agents/EnterpriseAiPlatform.Agents.Api/EnterpriseAiPlatform.Agents.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS final
WORKDIR /app

# Non-root security user setup
RUN adduser --disabled-password --gecos "" --uid 10001 appuser && chown -R appuser:appuser /app
USER 10001

COPY --from=build --chown=appuser:appuser /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/health/live || exit 1

ENTRYPOINT ["dotnet", "EnterpriseAiPlatform.Agents.Api.dll"]
